msgid "Send a stop name or code to get upcoming routes for the next %(interval)s minute."
msgid_plural "Send a stop name or code to get upcoming routes for the next %(interval)s minutes."
msgstr[0] "Pošaljite naziv stajališta ili kod da biste dobili polaske za naredni %(interval)s minut."
msgstr[1] "Pošaljite naziv stajališta ili kod da biste dobili polaske za naredna %(interval)s minuta."
msgstr[2] "Pošaljite naziv stajališta ili kod da biste dobili polaske za narednih %(interval)s minuta."

msgid "Please enter a stop name or code"
msgstr "Unesite naziv stajališta ili kod"

msgid "No matching service type found"
msgstr "Nije pronađen odgovarajući tip reda vožnje"

msgid "Not found"
msgstr "Ništa nije pronađeno"

msgid "Usage: /interval MINUTES"
msgstr "Upotreba: /interval MINUTI"

msgid "Invalid interval"
msgstr "Neispravan interval"

msgid "Interval set to %(minutes)s minute"
msgid_plural "Interval set to %(minutes)s minutes"
msgstr[0] "Interval je podešen na %(minutes)s minutu"
msgstr[1] "Interval je podešen na %(minutes)s minute"
msgstr[2] "Interval je podešen na %(minutes)s minuta"

msgid "Usage: /language LANGUAGE"
msgstr "Upotreba: /language JEZIK"

msgid "Unknown language"
msgstr "Nepoznat jezik"

msgid "Language switched to English"
msgstr "Jezik je promenjen na srpski"

msgid "No stops found nearby"
msgstr "Nema stajališta u blizini"
