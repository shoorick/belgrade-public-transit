msgid "Send a stop name or code to get upcoming routes for the next 30 minutes."
msgstr "Напишите название или код остановки, чтобы получить список маршрутов, проходящих через неё в ближайшие полчаса"

msgid "Please enter a stop name or code"
msgstr "Введите название или код остановки"

msgid "No matching service type found"
msgstr "Не найден подходящий тип расписания"

msgid "Not found"
msgstr "Ничего не найдено"

msgid "Usage: /interval MINUTES"
msgstr "Использование: /interval МИНУТЫ"

msgid "Invalid interval"
msgstr "Некорректный интервал"

msgid "Interval set to %(minutes)s minute"
msgid_plural "Interval set to %(minutes)s minutes"
msgstr[0] "Интервал установлен: %(minutes)s минута"
msgstr[1] "Интервал установлен: %(minutes)s минуты"
msgstr[2] "Интервал установлен: %(minutes)s минут"

msgid "Usage: /language LANGUAGE"
msgstr "Использование: /language ЯЗЫК"

msgid "Unknown language"
msgstr "Неизвестный язык"

msgid "Language switched to English"
msgstr "Язык изменён на русский"
